# 값은 커밋하지 않습니다. 로컬 값은 .env.local 에만 둡니다.
# 운영 BUN_DATABASE_URL 은 Vercel Production 에만 넣고, Preview·Development 에는 넣지 않습니다.

# 서버 전용. 로컬 예: postgresql://bun_app:<비밀번호>@127.0.0.1:54322/postgres
BUN_DATABASE_URL=

# 서버 전용. 32자 이상 무작위. IP 해시용.
BUN_IP_SALT=

# 공개. 애드센스 게시자 ID. 운영자가 확인하기 전에는 비워 둡니다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 공개. GA4 측정 ID. 운영자가 확인하기 전에는 비워 둡니다.
NEXT_PUBLIC_GA_ID=

# 공개. 사이트 주소.
NEXT_PUBLIC_SITE_URL=https://10bun.com

# 서버 전용. 기상청 단기예보(공공데이터포털) 서비스 키.
KMA_SERVICE_KEY=

# 서버 전용. 슬라이드 퍼즐 Storage(bun-puzzle) 목록·서명 URL.
BUN_SUPABASE_URL=
BUN_SUPABASE_SERVICE_KEY=
